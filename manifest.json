{
  "manifest_version": 3,
  "name": "PlaylistBulkEditor",
  "version": "1.0.0",
  "description": "Scan, filter, export and bulk-clean any YouTube playlist (including Watch Later) with watch progress.",
  "permissions": ["storage", "unlimitedStorage", "tabs", "scripting"],
  "host_permissions": ["https://www.youtube.com/*"],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "PlaylistBulkEditor",
    "default_popup": "popup.html"
  }
}
